    reverse_proxy http://rustfs:9000
}

http://cdn.perpixai.com {
    reverse_proxy http://rustfs:9000
}

http://api.perpixai.ir {
    reverse_proxy http://perpix-api:8000
}


http://app.perpixai.ir {
    @html_file path / /index.html
    header @html_file Cache-Control "no-cache, must-revalidate, max-age=0"

    @hashed_asset path /assets/* /fonts/*
    header @hashed_asset Cache-Control "public, max-age=31536000, immutable"

    reverse_proxy http://perpix-app:8080
}

